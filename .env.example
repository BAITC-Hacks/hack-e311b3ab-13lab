TILQAZYNA_BASE_URL=https://router.tilqazyna.kz/v1
TILQAZYNA_API_KEY=
ASR_MODEL=til-asr
TEXT_MODEL=qwen
DATA_DIR=data
MAX_UPLOAD_MB=100
API_TIMEOUT_SECONDS=900
ADMIN_EMAIL=admin@hattama.local
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Администратор
SESSION_HOURS=12
# Self-registration: approval (admin approves), open (instant participant) or closed
REGISTRATION_MODE=approval
# Password for the shared team accounts in backend/seed/users.json (min 10 chars)
SEED_PASSWORD=hattama-team-2026
DIARIZATION_MODEL_PATH=
# PostgreSQL. Empty means SQLite in DATA_DIR.
DATABASE_URL=
# MinIO or another S3-compatible store. Empty means files in DATA_DIR.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=hattama
MINIO_SECURE=false
# TTF font with Cyrillic for PDF; auto-detected when empty
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=
# Used by docker compose for the postgres and minio services
POSTGRES_PASSWORD=change-me-postgres
MINIO_ROOT_USER=hattama
MINIO_ROOT_PASSWORD=change-me-minio-password

# Optional GPU diarization worker over a private SSH tunnel
DIARIZATION_URL=
DIARIZATION_TOKEN=

# Live meetings
LIVE_MAX_SESSIONS=2
LIVE_MAX_MINUTES=180
LIVE_IDLE_SECONDS=120
# GPU diarization is skipped for live sessions longer than this (worker limit)
DIARIZATION_MAX_SECONDS=600
