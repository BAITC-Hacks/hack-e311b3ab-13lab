TILQAZYNA_BASE_URL=https://router.tilqazyna.kz/v1
TILQAZYNA_API_KEY=
ASR_MODEL=til-asr
TEXT_MODEL=qwen
DATA_DIR=data
MAX_UPLOAD_MB=100
API_TIMEOUT_SECONDS=900
ADMIN_EMAIL=admin@qorytyn.local
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Администратор
SESSION_HOURS=12
DIARIZATION_MODEL_PATH=
# PostgreSQL. Empty means SQLite in DATA_DIR.
DATABASE_URL=
# MinIO or another S3-compatible store. Empty means files in DATA_DIR.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=qorytyn
MINIO_SECURE=false
# TTF font with Cyrillic for PDF; auto-detected when empty
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=
# Used by docker compose for the postgres and minio services
POSTGRES_PASSWORD=change-me-postgres
MINIO_ROOT_USER=qorytyn
MINIO_ROOT_PASSWORD=change-me-minio-password
